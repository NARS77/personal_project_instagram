# =============================================================================
# MeatNDoor Instagram Intelligence & n8n Campaign Automation Environment Config
# =============================================================================

# --- n8n Workflow Integration ---
# Base URL of your n8n instance (Local instance or Cloud)
N8N_BASE_URL=http://localhost:5678

# Webhook endpoint URL created in your n8n campaign workflow
N8N_CAMPAIGN_WEBHOOK_URL=http://localhost:5678/webhook/meatndoor-campaign

# Optional n8n REST API key (Settings > API in n8n)
N8N_API_KEY=

# Optional shared secret header sent to verify webhook authenticity (X-Webhook-Secret)
N8N_WEBHOOK_SECRET=

# --- Campaign API Microservice (campaign_api.py) ---
# Host and port for Python campaign API server that n8n nodes call back to
CAMPAIGN_API_HOST=127.0.0.1
CAMPAIGN_API_PORT=8000

# Optional authentication token for incoming campaign API requests (Bearer or X-API-Token)
CAMPAIGN_API_TOKEN=

# --- Google Sheets & Local Excel Master Storage ---
# Target Google Spreadsheet ID for dual synchronization
DEFAULT_SPREADSHEET_ID=1sLCfz9Eho4OWjsDTILIVKNRtwVYbCoibFK6z6un7c_Y

# Path to local multi-tab Excel mirror workbook
DEFAULT_EXCEL_PATH=exports/instagram_research.xlsx
